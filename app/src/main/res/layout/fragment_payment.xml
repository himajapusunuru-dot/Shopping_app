<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/paymentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Payment Option"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/paymentRadioGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/paymentTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/codRadioButton"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/text_box_shape"
            android:buttonTint="@color/color_primary"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Cash On Delivery"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/internetBankingRadioButton"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/text_box_shape"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Internet Banking"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/cardRadioButton"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/text_box_shape"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Debit Card / Credit Card"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/paypalRadioButton"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/text_box_shape"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Pay Pal"
            android:textSize="16sp" />

    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="NEXT"
        app:backgroundTint="@color/color_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>